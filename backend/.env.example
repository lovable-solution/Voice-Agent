# Copy to backend/.env and fill in your key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Live conversation. Low effort keeps the client's response time short.
CHAT_MODEL=claude-opus-5-5
CHAT_EFFORT=low
CHAT_MAX_TOKENS=8192

# Analysis of the job posting / partnership ideas before the meeting.
BRIEFING_MODEL=claude-opus-5-5
BRIEFING_EFFORT=medium

# Retry safety-classifier refusals on Anthropic's recommended fallback model.
ENABLE_REFUSAL_FALLBACKS=true

# Origins allowed to call the API from a browser (JSON list).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SESSION_TTL_MINUTES=240
MAX_UPLOAD_MB=10
